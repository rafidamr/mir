# Copy to .env for local development.
DATABASE_URL=postgres://mir:mir@localhost:5433/mir
PORT=8080

# Each model's id, whether its provider may train on what it's sent, how much it thinks before
# answering (none, minimal, low, medium, high or xhigh), and its prices (US dollars per million
# tokens; thinking is billed as output). The router tries the cheapest model first.
GEMINI_API_KEY=
GEMINI_MODEL='{"id": "gemini-3.5-flash-lite", "training_allowed": true, "reasoning": "low", "cost": {"input": 0, "output": 0}}'
OPENROUTER_API_KEY=
OPENROUTER_MODEL='{"id": "openai/gpt-6-luna", "training_allowed": false, "reasoning": "none", "cost": {"input": 0.1, "output": 0.5}}'
