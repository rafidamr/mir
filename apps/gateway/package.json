{
  "name": "@mir/gateway",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node src/server.ts",
    "data:prepare": "node scripts/prepare-data.ts",
    "data:benchmark": "node scripts/vote-benchmark.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "live-check": "node --env-file-if-exists=.env scripts/live-check.ts",
    "check-deployment": "node --env-file=.env.production scripts/check-deployment.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "eval": "node --env-file-if-exists=.env scripts/eval.ts",
    "grade": "node scripts/grade.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.105",
    "@hono/node-server": "2.1.5",
    "@huggingface/transformers": "4.3.1",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "ai": "7.0.153",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.34",
    "csv-parse": "7.0.3",
    "drizzle-kit": "0.31.11"
  }
}
