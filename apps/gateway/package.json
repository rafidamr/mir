{
  "name": "@mir/gateway",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node src/server.ts",
    "data:prepare": "node scripts/prepare-data.ts",
    "data:benchmark": "node scripts/vote-benchmark.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=../../.env scripts/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@huggingface/transformers": "4.3.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "csv-parse": "7.0.3",
    "drizzle-kit": "0.31.11"
  }
}
