# Copy to .env for local development.
DATABASE_URL=postgres://mir:mir@localhost:5433/mir
PORT=8080

# Each model's id, whether its provider may train on what it's sent, and its prices
# (US dollars per million tokens). The router tries the cheapest model first.
GEMINI_API_KEY=
GEMINI_MODEL='{"id": "gemini-3.5-flash-lite", "training_allowed": true, "cost": {"input": 0, "output": 0, "reasoning": 0}}'
OPENROUTER_API_KEY=
OPENROUTER_MODEL='{"id": "google/gemma-4-26b-a4b-it:free", "training_allowed": false, "cost": {"input": 0, "output": 0, "reasoning": 0}}'
